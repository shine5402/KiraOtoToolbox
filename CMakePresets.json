{
    "version"         : 8,
    "configurePresets": [
        {
            "name"          : "_base",
            "hidden"        : true,
            "generator"     : "Ninja",
            "binaryDir"     : "${sourceDir}/build/",
            "cacheVariables": {"CMAKE_CXX_STANDARD": "23"}
        },
        {
            "name"          : "_macos-base",
            "hidden"        : true,
            "inherits"      : "_base",
            "condition"     : {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES"    : "x86_64;arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
            }
        },
        {
            "name"     : "_linux-base",
            "hidden"   : true,
            "inherits" : "_base",
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
        },
        {
            "name"     : "_windows-base",
            "hidden"   : true,
            "inherits" : "_base",
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
        },
        {
            "name"          : "macos-debug-template",
            "displayName"   : "macOS Debug",
            "inherits"      : "_macos-base",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
        },
        {
            "name"          : "macos-relwithdebinfo-template",
            "displayName"   : "macOS RelWithDebInfo",
            "inherits"      : "_macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE"       : "RelWithDebInfo",
                "OSX_SEPARATE_DEBUG_INFO": "ON",
                "CMAKE_INSTALL_PREFIX"   : "${sourceDir}/build/artifact"
            }
        },
        {
            "name"          : "linux-debug-template",
            "displayName"   : "Linux Debug",
            "inherits"      : "_linux-base",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
        },
        {
            "name"          : "linux-relwithdebinfo-template",
            "displayName"   : "Linux RelWithDebInfo",
            "inherits"      : "_linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE"    : "RelWithDebInfo",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/artifact"
            }
        },
        {
            "name"          : "windows-debug-template",
            "displayName"   : "Windows Debug",
            "inherits"      : "_windows-base",
            "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
        },
        {
            "name"          : "windows-relwithdebinfo-template",
            "displayName"   : "Windows RelWithDebInfo",
            "inherits"      : "_windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE"    : "RelWithDebInfo",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/artifact"
            }
        }
    ],
    "buildPresets"    : [
        {"name": "macos-debug-template",            "configurePreset": "macos-debug-template"           },
        {"name": "macos-relwithdebinfo-template",   "configurePreset": "macos-relwithdebinfo-template"  },
        {"name": "linux-debug-template",            "configurePreset": "linux-debug-template"           },
        {"name": "linux-relwithdebinfo-template",   "configurePreset": "linux-relwithdebinfo-template"  },
        {"name": "windows-debug-template",          "configurePreset": "windows-debug-template"         },
        {"name": "windows-relwithdebinfo-template", "configurePreset": "windows-relwithdebinfo-template"}
    ]
}
