{
    "id": "top.shine5402.KiraOtoToolbox",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "KiraOtoToolbox",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=host"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "kiraototoolbox",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "build-args": ["--share=network"]
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DKIRAOTOTOOLBOX_BUILD_TESTING=OFF",
                "-DKIRAOTOTOOLBOX_INSTALL=ON",
                "-DKIRAOTOTOOLBOX_DEPLOY_QT=OFF"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
